# Copia este archivo a .env.local y rellena tus valores.
# Ver README.md > "Configurar JSONBin" para las instrucciones paso a paso.
#
# ⚠️ IMPORTANTE: las claves de JSONBin empiezan por $2a$10$… y Next.js expande
# los $ de los .env como si fueran variables (la clave llega vacía y la app
# dice "Falta configurar JSONBin"). Escapa TODOS los $ con \, así:
#   NEXT_PUBLIC_JSONBIN_API_KEY=\$2a\$10\$loQueSea...
# En los Secrets de GitHub Actions NO hay que escapar nada: se pegan tal cual.

# Id del bin de JSONBin que guarda el JSON completo de la boda.
NEXT_PUBLIC_JSONBIN_BIN_ID=

# Access Key de JSONBin (NO la Master Key) restringida a ese único bin con
# permisos de lectura/escritura. Esta clave queda visible en el bundle público
# al desplegar en GitHub Pages: por eso debe ser una Access Key acotada.
NEXT_PUBLIC_JSONBIN_API_KEY=

# Solo para uso local (scripts/init-bin.mjs). Nunca se incluye en el build.
JSONBIN_MASTER_KEY=
